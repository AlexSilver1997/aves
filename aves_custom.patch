+import 'package:aves/model/entry/sort.dart';
+import 'package:aves/model/settings/settings.dart';
+import 'package:aves/model/filters/covered/stored_album.dart';
+import 'package:aves_model/aves_model.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../common.dart';
+import '../fake/media_store_service.dart';
+
+void main() {
+  setUpAll(() async {
+    await setUpAllServices();
+  });
+
+  setUp(() async {
+    await setUpServices();
+  });
+
+  tearDownAll(() async {
+    await tearDownAllServices();
+  });
+
+  test('file name sorting uses the filesystem name, not the source title', () {
+    final alpha = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'a-file')..sourceTitle = 'Zulu title';
+    final zulu = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'z-file')..sourceTitle = 'Alpha title';
+    final entries = [zulu, alpha]..sort(AvesEntrySort.compareByName);
+    expect(entries, [alpha, zulu]);
+  });
+
+  test('date added and modified keep missing metadata last in both directions', () {
+    final newest = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'newest')
+      ..dateAddedSecs = 300
+      ..dateModifiedMillis = 300000;
+    final oldest = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'oldest')
+      ..dateAddedSecs = 100
+      ..dateModifiedMillis = 100000;
+    final unknown = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'unknown')
+      ..dateAddedSecs = 0
+      ..dateModifiedMillis = 0;
+
+    final addedDescending = [oldest, unknown, newest]..sort(AvesEntrySort.compareByDateAdded);
+    expect(addedDescending, [newest, oldest, unknown]);
+
+    final addedAscending = [oldest, unknown, newest]
+      ..sort((a, b) => AvesEntrySort.compareByDateAdded(a, b, reverse: true));
+    expect(addedAscending, [oldest, newest, unknown]);
+
+    final modifiedDescending = [oldest, unknown, newest]..sort(AvesEntrySort.compareByDateModified);
+    expect(modifiedDescending, [newest, oldest, unknown]);
+
+    final modifiedAscending = [oldest, unknown, newest]
+      ..sort((a, b) => AvesEntrySort.compareByDateModified(a, b, reverse: true));
+    expect(modifiedAscending, [oldest, newest, unknown]);
+  });
+
+  test('format and size keep missing metadata last in both directions', () {
+    final jpg = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'b')
+      ..path = '/storage/emulated/0/Pictures/test/b.jpg'
+      ..sizeBytes = 500;
+    final png = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'a')
+      ..path = '/storage/emulated/0/Pictures/test/a.png'
+      ..sizeBytes = 100;
+    final unknown = FakeMediaStoreService.newImage('/storage/emulated/0/Pictures/test', 'unknown')
+      ..path = null
+      ..sizeBytes = null;
+
+    final formatAscending = [unknown, jpg, png]..sort(AvesEntrySort.compareByFormat);
+    expect(formatAscending, [jpg, png, unknown]);
+
+    final formatDescending = [unknown, jpg, png]
+      ..sort((a, b) => AvesEntrySort.compareByFormat(a, b, reverse: true));
+    expect(formatDescending, [png, jpg, unknown]);
+
+    final sizeDescending = [unknown, png, jpg]..sort(AvesEntrySort.compareBySize);
+    expect(sizeDescending, [jpg, png, unknown]);
+
+    final sizeAscending = [unknown, png, jpg]
+      ..sort((a, b) => AvesEntrySort.compareBySize(a, b, reverse: true));
+    expect(sizeAscending, [png, jpg, unknown]);
+  });
+
+  test('individual album sorting is isolated from global sorting', () {
+    final albumA = {StoredAlbumFilter('/storage/emulated/0/Pictures/A', 'A')};
+    final albumB = {StoredAlbumFilter('/storage/emulated/0/Pictures/B', 'B')};
+
+    settings.setStoredCollectionSortFactor({}, .date);
+    settings.setStoredCollectionSortReverse({}, false);
+    settings.setStoredCollectionSectionFactor({}, .month);
+
+    settings.setStoredCollectionSortFactor(albumA, .dateAdded);
+    settings.setStoredCollectionSortReverse(albumA, true);
+    settings.setStoredCollectionSectionFactor(albumA, .none);
+
+    settings.setStoredCollectionSortFactor({}, .format);
+    settings.setStoredCollectionSortReverse({}, true);
+
+    expect(settings.getStoredCollectionSortFactor(albumA), SortFactor.dateAdded);
+    expect(settings.getStoredCollectionSortReverse(albumA), isTrue);
+    expect(settings.getStoredCollectionSectionFactor(albumA), EntrySectionFactor.none);
+
+    expect(settings.getStoredCollectionSortFactor(albumB), SortFactor.format);
+    expect(settings.getStoredCollectionSortReverse(albumB), isTrue);
+    expect(settings.getStoredCollectionSectionFactor(albumB), EntrySectionFactor.month);
+
+    settings.renameStoredCollectionSort('/storage/emulated/0/Pictures/A', '/storage/emulated/0/Pictures/Renamed');
+    final renamedAlbum = {StoredAlbumFilter('/storage/emulated/0/Pictures/Renamed', 'Renamed')};
+    expect(settings.getStoredCollectionSortFactor(renamedAlbum), SortFactor.dateAdded);
+    expect(settings.getStoredCollectionSortReverse(renamedAlbum), isTrue);
+  });
+}
