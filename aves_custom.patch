+++ b/scripts/build_custom_apk.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+if ! command -v flutter >/dev/null 2>&1; then
+  echo "ERROR: Flutter SDK is not installed or flutter is not on PATH." >&2
+  echo "Install Flutter 3.47.8 and Android SDK (platform 37), then retry." >&2
+  exit 2
+fi
+
+FLUTTER_VERSION="$(flutter --version 2>/dev/null | head -n 1 || true)"
+echo "Detected: $FLUTTER_VERSION"
+if [[ "$FLUTTER_VERSION" != *"3.47.8"* ]]; then
+  echo "ERROR: This source snapshot expects Flutter 3.47.8." >&2
+  exit 2
+fi
+
+if [[ ! -f android/key.properties ]]; then
+  echo "ERROR: android/key.properties is missing." >&2
+  echo "Copy android/key.properties.example to android/key.properties and configure a persistent signing keystore." >&2
+  exit 2
+fi
+
+if [[ -z "${ANDROID_HOME:-}" && -z "${ANDROID_SDK_ROOT:-}" ]]; then
+  echo "ERROR: Set ANDROID_HOME or ANDROID_SDK_ROOT to an installed Android SDK." >&2
+  exit 2
+fi
+
+flutter doctor -v
+# Select the non-Play flavor: this avoids requiring the upstream Firebase app registration.
+cp flavors/pubspec_izzy.yaml pubspec.yaml
+cp flavors/pubspec_izzy.lock pubspec.lock
+flutter pub get --enforce-lockfile
+flutter analyze
+flutter test
+flutter build apk --flavor izzy --release --no-pub
+
+APK="build/app/outputs/flutter-apk/app-izzy-release.apk"
+if [[ ! -s "$APK" ]]; then
+  echo "ERROR: Expected APK was not created at $APK" >&2
+  find build/app/outputs -maxdepth 3 -type f -name '*.apk' -print 2>/dev/null || true
+  exit 3
+fi
+
+if command -v apksigner >/dev/null 2>&1; then
+  apksigner verify --verbose "$APK"
+fi
+sha256sum "$APK"
+echo "SUCCESS: $ROOT/$APK"
